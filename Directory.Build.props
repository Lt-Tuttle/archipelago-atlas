<Project>
  <!-- Shared by every project in the repository (the app, AP_Atlas.Core and the tests). -->
  <PropertyGroup>
    <!-- The one place Atlas's version is set (SemVer). Tools/bump_version.ps1 changes it; the build adds the commit. -->
    <Version>0.1.0-beta.1</Version>
    <!-- No warning goes unseen: any compiler, analyzer, MSBuild or NuGet warning (a package with a known vulnerability,
         say) stops the build, here and in CI. Fix the cause; don't silence it. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <!-- The code-style rules .editorconfig makes warnings (dead private members) are checked in every build too. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Where crash reports go when the user allows them (Sentry's DSN, a public value): set by the release build from the
         SENTRY_DSN variable, or as a property; a build without one has no crash reporting. -->
    <SentryDsn Condition="'$(SentryDsn)' == ''">$(SENTRY_DSN)</SentryDsn>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="SentryDsn" Value="$(SentryDsn)" />
  </ItemGroup>
</Project>
