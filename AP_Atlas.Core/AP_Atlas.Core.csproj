<Project Sdk="Microsoft.NET.Sdk">
  <!-- Atlas's code that doesn't need Godot: saving, logging, the web client, parsers and tables. Without a Godot
       reference it can't touch the window from a worker thread, and its tests run with plain "dotnet test". -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>AP_Atlas.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Archipelago.MultiClient.Net: for net10.0 NuGet picks the package's lib/net6.0 build, the only one that enables
         websocket compression (the netstandard2.0 build can't), which the Archipelago server asks clients to use.
         Connections/AtlasSessions relies on its internal data cache: check it (the unit tests do) before updating. -->
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
    <!-- 13.0.1 and later limit JSON nesting to 64 levels by default, so deeply nested input can't overflow the stack. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Build-time only (never shipped): flags async mistakes such as unobserved tasks and blocking waits. -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
  <ItemGroup>
    <!-- The fake logic engine's Python side, for tests (Testing/FakeLogicEngine.cs writes it out). -->
    <EmbeddedResource Include="Testing\fake_engine.py" LogicalName="AP_Atlas.Core.Testing.fake_engine.py" />
  </ItemGroup>
  <ItemGroup>
    <!-- Atlas's own documents, as the Help window shows them: one source, the repository's files (see Docs.cs). -->
    <EmbeddedResource Include="..\docs\GUIDE.md" LogicalName="Docs.GUIDE.md" />
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="Docs.CHANGELOG.md" />
    <EmbeddedResource Include="..\CREDITS.md" LogicalName="Docs.CREDITS.md" />
    <EmbeddedResource Include="..\THIRD_PARTY_NOTICES.md" LogicalName="Docs.THIRD_PARTY_NOTICES.md" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="Docs.LICENSE" />
    <EmbeddedResource Include="..\docs\wordmark\wordmark-dark.svg" LogicalName="Docs.wordmark-dark.svg" />
    <EmbeddedResource Include="..\docs\wordmark\wordmark-light.svg" LogicalName="Docs.wordmark-light.svg" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AP_Atlas" />
    <InternalsVisibleTo Include="AP_Atlas.Core.Tests" />
  </ItemGroup>
</Project>
