<Project Sdk="Godot.NET.Sdk/4.3.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" $(GodotTargetPlatform) == 'android' ">net8.0-android</TargetFramework>
    <TargetFramework Condition=" $(GodotTargetPlatform) == 'ios' ">net8.0-ios</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>12</LangVersion>
    <!-- The one place Atlas's version is set (SemVer). Tools/bump_version.ps1 changes it; the build adds the commit. -->
    <Version>0.1.0-beta.1</Version>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Archipelago.MultiClient.Net: for net8.0 NuGet picks the package's lib/net6.0 build, the only one that enables
         websocket compression (the netstandard2.0 build can't), which the Archipelago server asks clients to use. -->
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
    <!-- 13.0.1 and later limit JSON nesting to 64 levels by default, so deeply nested input can't overflow the stack. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Atlas Engine's Python, written into the engine at setup. -->
    <EmbeddedResource Include="Scripts/Core/Engine/Python/atlas_bridge.py" LogicalName="AtlasEngine.atlas_bridge.py" />
    <EmbeddedResource Include="Scripts/Core/Engine/Python/atlas_run.py" LogicalName="AtlasEngine.atlas_run.py" />
    <EmbeddedResource Include="Scripts/Core/Engine/Data/apworld_sources.json" LogicalName="AtlasEngine.apworld_sources.json" />
    <!-- Archipelago's Python packages, exact versions and file hashes (Tools/build_engine_lock.py). -->
    <EmbeddedResource Include="Scripts/Core/Engine/Data/engine_packages.lock.txt" LogicalName="AtlasEngine.engine_packages.lock" />
  </ItemGroup>
</Project>

